{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate --no-hints",
    "clean": "rm -rf .next dist .turbo coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@monaco-editor/react": "4.7.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "1.1.1",
    "@react-pdf/renderer": "3.4.4",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "7.0.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.30.0",
    "mammoth": "1.8.0",
    "next": "15.5.23",
    "next-auth": "4.24.11",
    "pdf-parse": "1.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.13.3",
    "resend": "4.0.1",
    "sonner": "1.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "15.5.23",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "4.19.2",
    "typescript": "^5",
    "vitest": "2.1.8"
  }
}
