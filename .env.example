# ============================================================================
# DevFusion — environment template
# Copy to .env (gitignored) and fill in. Never commit a real .env.
# ============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=INFO

# ---- Web (Next.js) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=DevFusion

# ---- API (FastAPI) ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgres://devfusion:devfusion@localhost:5432/devfusion
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ---- Cache -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Auth (REQUIRED) -------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_32_plus_char_random_string
AUTH_SECRET=replace_me_with_a_32_plus_char_random_string
JWT_EXPIRES_IN=7d

# ---- OAuth (optional) ------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- AI providers (at least one required) ----------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_MODEL=gpt-4o-mini

# ---- Email (magic-link auth) -----------------------------------------------
EMAIL_FROM=noreply@devfusion.local
EMAIL_PROVIDER=console          # console | smtp | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# ---- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=devfusion
