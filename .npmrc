# pnpm 9.x to match the lockfile
package-manager-strict=false
auto-install-peers=true
strict-peer-dependencies=false

# Skip @prisma/client's auto postinstall at the workspace root — there's no
# prisma/schema.prisma here. The real schema lives in apps/web and is generated
# by apps/web's own postinstall script.
PRISMA_SKIP_POSTINSTALL_GENERATE=true
