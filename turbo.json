{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "AUTH_SECRET",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "RESEND_API_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "DIRECT_URL",
        "AUTH_SECRET",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}
